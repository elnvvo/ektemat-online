# Kopier til .env og fyll inn egne verdier. .env skal aldri committes.
# Lag en nøkkel med: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Passord for seed-brukerne (bare lokale testdata)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Bildetjeneste (US-05). Uten nøkkel brukes et lokalt demo-bilde.
IMAGE_API_KEY=
IMAGE_API_URL=

# Lagring (Oblig 5): sqlite (standard) eller neo4j
STORAGE=

# Neo4j AuraDB – brukes når STORAGE=neo4j. NEO4J_DATABASE er valgfri.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
